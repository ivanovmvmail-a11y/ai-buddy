# Скопируйте в backend/.env и заполните. Файл .env НЕ коммитится.
# gigachat | openai | echo
LLM_PROVIDER=echo

# Authorization Key из developers.sber.ru
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# путь к russian_trusted_root_ca.cer (рекомендуется, см. README)
GIGACHAT_CA_BUNDLE_FILE=
GIGACHAT_VERIFY_SSL=true

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

FRONTEND_ORIGINS=http://localhost:3000
