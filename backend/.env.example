# Скопируйте в backend/.env и заполните. Файл .env НЕ коммитится.
# gigachat | openai | scenario (без ключа: сценарный режим, спека 003) | echo (заглушка для разработки)
LLM_PROVIDER=scenario
# Случайность ответов модели (0.1 — строго и одинаково; GigaChat не принимает 0)
LLM_TEMPERATURE=0.1

# Authorization Key из developers.sber.ru
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# свой путь к сертификату; по умолчанию берётся backend/certs/russian_trusted_root_ca.cer
GIGACHAT_CA_BUNDLE_FILE=
# используется, только если сертификата нет
GIGACHAT_VERIFY_SSL=true
# эмбеддинги для поиска по документам: fake (по словам, без ключей) | gigachat (нужен оплаченный пакет эмбеддингов).
# после смены перезагрузите документы: uv run python -m app.rag.ingest
EMBEDDINGS_PROVIDER=fake
GIGACHAT_EMBEDDINGS_MODEL=Embeddings

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL. В Docker подставляется автоматически (docker-compose.yml), здесь — для запуска без Docker
DATABASE_URL=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

FRONTEND_ORIGINS=http://localhost:3000

# Агент → сервисы: direct (вызов в процессе, по умолчанию без Docker) | mcp (MCP-клиент, нужен `uv sync --extra mcp`;
# в Docker включено в backend/Dockerfile)
AGENT_SERVICES=
# MCP-сервер по сети (Streamable HTTP): адрес и ключ службы. Пусто = MCP в памяти процесса.
# В docker compose задано: MCP_URL=http://mcp:8001/mcp, ключ — MCP_SERVICE_TOKEN (своё значение для стенда)
MCP_URL=
MCP_SERVICE_TOKEN=

# Журнал сервера: DEBUG | INFO | WARNING (пусто = INFO)
LOG_LEVEL=

# Код-слово для демо-кнопок «Сброс» / «Следующий день» (пусто = без пароля; на публичном сайте задать)
DEMO_KEY=

# MCP/stdio: один пользователь на процесс; --user имеет приоритет.
# Для чтения этой строки из .env: uv run --env-file .env --extra mcp python -m app.mcp_server.server
MCP_USER_ID=

# Интеграции (docs/INTEGRATION.md). Пусто = вход выключен.
# Ключ службы для системы найма: POST /integrations/hired с заголовком Authorization: Bearer <ключ>
INTEGRATION_TOKEN=
# Токен исходящего вебхука / slash-команды Mattermost (POST /integrations/mattermost)
MATTERMOST_TOKEN=
# Логин Mattermost=id в AI-buddy, через запятую (пусто — логин совпадает с id: intern-anya)
MATTERMOST_USERS=
