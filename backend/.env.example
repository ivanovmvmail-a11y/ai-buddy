# Скопируйте в backend/.env и заполните. Файл .env НЕ коммитится.
# gigachat | openai | scenario (без ключа: сценарный режим, спека 003) | echo (заглушка для разработки)
LLM_PROVIDER=scenario

# Authorization Key из developers.sber.ru
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# свой путь к сертификату; по умолчанию берётся backend/certs/russian_trusted_root_ca.cer
GIGACHAT_CA_BUNDLE_FILE=
# используется, только если сертификата нет
GIGACHAT_VERIFY_SSL=true
# эмбеддинги для поиска по документам: fake (по словам, без ключей) | gigachat (нужен оплаченный пакет эмбеддингов).
# после смены перезагрузите документы: uv run python -m app.rag.ingest
EMBEDDINGS_PROVIDER=fake
GIGACHAT_EMBEDDINGS_MODEL=Embeddings

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL. В Docker подставляется автоматически (docker-compose.yml), здесь — для запуска без Docker
DATABASE_URL=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

FRONTEND_ORIGINS=http://localhost:3000

# MCP/stdio: один пользователь на процесс; --user имеет приоритет.
# Для чтения этой строки из .env: uv run --env-file .env --extra mcp python -m app.mcp_server.server
MCP_USER_ID=
